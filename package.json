{
  "name": "dsh-preset-composer",
  "version": "0.1.0",
  "description": "Visual composer for DSH agent presets.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "agent-preset",
    "cordis"
  ],
  "author": "DAnonyvinciT",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": "./lib/index.js",
    "./store": "./lib/store.js",
    "./model": "./lib/model.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "client.js",
    "cordis.patch.yml",
    "locale",
    "docs",
    "icon.svg",
    "assets/icon-180.png",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test test/"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DAnonyvinciT/dsh-preset-composer.git"
  },
  "homepage": "https://github.com/DAnonyvinciT/dsh-preset-composer#readme",
  "bugs": {
    "url": "https://github.com/DAnonyvinciT/dsh-preset-composer/issues"
  },
  "engines": {
    "dsh": ">=0.2.0 <0.3.0"
  }
}
